# FILMIO environment template
# Copy this file to .env locally and replace placeholders with your own values.
# Never commit .env or share secret values.

# Server
NODE_ENV=development
PORT=5000
SITE_URL=https://vishnuva.in
CORS_ORIGINS=
LOG_LEVEL=info

# Frontend / Vite
BASE_PATH=/
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PROXY_URL=

# Clerk
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Movie catalog providers
TMDB_API_KEY=
OMDB_API_KEY=
CATALOG_FALLBACK_BASE_URL=
CATALOG_FALLBACK_API_KEY=
CATALOG_FALLBACK_NAME=
CATALOG_FALLBACK_ATTRIBUTION=
CATALOG_FALLBACK_QUOTA=

# Object storage
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PRIVATE_OBJECT_DIR=

# Optional advertising / server configuration
VAST_AD_TAG_URL=
SSR_API_BASE_URL=http://127.0.0.1:5000/api
REPL_ID=
REPLIT_DEV_DOMAIN=
REPLIT_EXPO_DEV_DOMAIN=