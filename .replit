modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "mad-max"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "mobile-production-build"

[[workflows.workflow]]
name = "mad-max"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mad-max test && pnpm --filter @workspace/mad-max typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "mobile-production-build"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mad-max-mobile build:check"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 22520
externalPort = 80

[[ports]]
localPort = 31000
externalPort = 3003

[[ports]]
localPort = 31001
externalPort = 3001

[objectStorage]
defaultBucketID = "replit-objstore-cfa6a3a5-2f90-4fba-927d-b160ef18af95"
